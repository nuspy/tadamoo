<Project Sdk="Microsoft.NET.Sdk">
  <!-- the parts of the desktop app's server list that need no window: the address rules and the list kept on disk (tests/test_desktop_servers.py runs it) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\desktop\ServerList.cs" />
  </ItemGroup>
</Project>
