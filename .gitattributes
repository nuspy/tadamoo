# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text
# the table is checked byte for byte (tools/check_benchmarks.py), so it stays LF on every checkout
docs/community/benchmarks.json text eol=lf
# shell scripts and the Linux/container deploy files run on Linux: LF on every checkout
*.sh text eol=lf
deploy/** text eol=lf
# vendored upstream code is kept byte for byte, so an update shows only what upstream changed
third_party/** -text
# the documents of the evaluation are read byte for byte (the checker compares a hash of each original)
tadamoo/eval/fixtures/documents/** binary
