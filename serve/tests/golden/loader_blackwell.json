 "safe_why": {
  "engine.expert-cache": {
   "en": "auto: every MiB of VRAM left after the reserve holds experts.",
   "it": "auto: tutta la VRAM che resta oltre la riserva contiene esperti."
  },
  "engine.kv": {
   "en": "q4_0: the smallest KV cache, more VRAM left for experts.",
   "it": "q4_0: la cache KV pi\u00f9 piccola, pi\u00f9 VRAM per gli esperti."
  },
  "engine.max-context": {
   "en": "The model's full context; with q4_0 its KV cache is 2.1 GiB.",
   "it": "Il contesto intero del modello; con q4_0 la cache KV \u00e8 di 2,1 GiB."
  },
  "engine.ple-io": {
   "en": "ram: the PLE table fits in RAM with 15% of RAM and of the commit free.",
   "it": "ram: la tabella PLE ci sta in RAM lasciando liberi il 15% della RAM e del commit."
  },
  "engine.pool-workers": {
   "en": "15 CPU workers: the 8 performance cores and half the 16 efficiency cores, less one; the rest stay for the system.",
   "it": "15 thread CPU: i 8 core performance e met\u00e0 dei 16 core efficienza, meno uno; il resto resta al sistema."
  },
  "engine.prefill": {
   "en": "auto: the prompt is read in large chunks that borrow expert-cache slots.",
   "it": "auto: il prompt si legge a blocchi grandi che prendono in prestito posti della cache esperti."
  },
  "engine.resident-experts": {
   "en": "on: the experts outside the GPU cache are copied to RAM once, not read from disk.",
   "it": "attivo: gli esperti fuori dalla cache GPU sono copiati in RAM una volta, non letti dal disco."
  },
  "engine.spec": {
   "en": "7: the drafter proposes up to 6 tokens per step; the usual best speed.",
